"""Shows how https://www.typescriptlang.org/tsconfig/#declarationDir can be used to write
.d.ts typings files to a different folder than the JavaScript outputs."""

load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@bazel_lib//lib:testing.bzl", "assert_outputs")
load("@bazel_skylib//rules:build_test.bzl", "build_test")

ts_project(
    name = "transpile",
    srcs = ["dir/lib.ts"],
    declaration = True,
    declaration_dir = "out/types",
    declaration_map = True,
    out_dir = "out/code",
    root_dir = "dir",
    source_map = True,
)

# Assert that the output locations we wrote to match expectations
assert_outputs(
    name = "check_transpile",
    actual = ":transpile",
    expected = [
        "declaration_dir/out/code/lib.js",
        "declaration_dir/out/code/lib.js.map",
    ],
)

# Convert the types output group to the default output
filegroup(
    name = "types",
    srcs = [":transpile"],
    output_group = "types",
)

assert_outputs(
    name = "check_types",
    actual = ":types",
    expected = [
        "declaration_dir/out/types/lib.d.ts",
        "declaration_dir/out/types/lib.d.ts.map",
    ],
)

# The rootDir/exclude guard must see an "exclude" inherited through the
# tsconfig extends chain — including when declaration_dir is set, where tsc
# would otherwise materialize an implicit exclude entry for declarationDir
# that must not be confused with a user-authored one.
ts_project(
    name = "extends_exclude",
    srcs = ["dir/lib.ts"],
    declaration = True,
    declaration_dir = "types_extends",
    extends = "tsconfig-base.json",
    root_dir = "dir",
    tsconfig = "tsconfig-extends.json",
)

build_test(
    name = "extends_exclude_test",
    targets = [":extends_exclude"],
)
