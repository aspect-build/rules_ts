load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_ts//ts:defs.bzl", "ts_project")

ts_project(
    name = "frontend",
    isolated_typecheck = True,
    tsconfig = {
        "compilerOptions": {
            "declaration": True,
            "isolatedDeclarations": True,
        },
    },
    deps = ["//isolated_typecheck/core"],
)

build_test(
    name = "targets_test",
    targets = [
        ":frontend",
        ":frontend_types",
        ":frontend_typecheck",
        ":frontend_typecheck_test",
    ],
)
