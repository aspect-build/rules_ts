bazel_dep(name = "aspect_rules_ts", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "aspect_rules_ts",
    path = "../..",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2", dev_dependency = True)

# A native TypeScript version: ts_project invokes the pre-compiled tsc binary
# for the exec platform directly via toolchain resolution, without NodeJS.
ts = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript", dev_dependency = True)
ts.toolchain(
    version = "7.0.2",
)

# A second native version, selected per-target via ts_project(tsc)
# instead of the globally registered toolchain.
ts.toolchain(
    name = "npm_typescript_7rc",
    version = "7.0.1-rc",
)
use_repo(ts, "npm_typescript", "npm_typescript_7rc")
